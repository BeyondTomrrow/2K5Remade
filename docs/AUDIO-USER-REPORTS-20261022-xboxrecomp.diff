+                        float alpha = sw / (2.0f * q[sct]), a0 = 1.0f + alpha;
+                        b0[sct] = (1.0f - cw) * 0.5f / a0; b1[sct] = (1.0f - cw) / a0; b2[sct] = b0[sct];
+                        a1[sct] = -2.0f * cw / a0; a2[sct] = (1.0f - alpha) / a0;
+                    }
+                }
+                if (!off_lp) {
+                    float *ch[2] = { &left, &right };
