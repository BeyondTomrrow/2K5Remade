+    /* Anti-imaging low-pass. The console's VP band-limits what it
+     * upsamples: xemu's output has nothing above the sources' Nyquist
+     * (a cliff at ~11 kHz for the 22 kHz crowd/commentary), ours carried
+     * cubic-interpolation images up to 20 kHz (-80..-120 dB/Hz, a fizz on
+     * every voice; docs/AUDIO-USER-REPORTS-20261022.md). Two biquads
+     * (4th-order Butterworth) at 90 % of the source Nyquist, per voice,
+     * only when the voice is upsampled. RECOMP_APU_NO_LOWPASS=1 turns it off. */
+    {
+        static int off = -1;
+        if (off < 0) off = getenv("RECOMP_APU_NO_LOWPASS") != NULL;
+        if (!off && rate > 1.05f) {
+            if (fabsf(rate - r->lp_rate) > 0.01f * rate) {
+                float fc = 0.45f * 48000.0f / rate;
+                float w0 = 2.0f * 3.14159265f * fc / 48000.0f, cw = cosf(w0), sw = sinf(w0);
+                static const float q[2] = { 0.54119610f, 1.30656296f };
+                for (int s = 0; s < 2; s++) {
+                    float alpha = sw / (2.0f * q[s]), a0 = 1.0f + alpha;
+                    r->lp_b0[s] = (1.0f - cw) * 0.5f / a0; r->lp_b1[s] = (1.0f - cw) / a0; r->lp_b2[s] = r->lp_b0[s];
+                    r->lp_a1[s] = -2.0f * cw / a0; r->lp_a2[s] = (1.0f - alpha) / a0;
+                }
+                r->lp_rate = rate;
+            }
+            for (int i = 0; i < requested_num; i++)
+                for (int c = 0; c < 2; c++) {
+                    float x = samples[i][c];
+                    for (int s = 0; s < 2; s++) {
+                        float *z = r->lp_z[s][c];
+                        float y = r->lp_b0[s] * x + z[0];
+                        z[0] = r->lp_b1[s] * x - r->lp_a1[s] * y + z[1];
+                        z[1] = r->lp_b2[s] * x - r->lp_a2[s] * y;
+                        x = y;
+                    }
+                    samples[i][c] = x;
+                }
+        } else if (off) {
+            r->lp_rate = 0.0f;
+        }
