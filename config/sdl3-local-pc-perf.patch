 // Command Buffers
 
+/* 2K5Remade local: GPU pass timing. Each command buffer writes a timestamp
+ * where every render pass, copy pass, blit, mip generation and defrag begins
+ * and one at the end; the time between two stamps belongs to what began at
+ * the first. Results are read when the command buffer is cleaned and logged
+ * every 300 command buffers, grouped by kind and target size. */
+enum { TSK_START, TSK_RENDER, TSK_COPY, TSK_BLIT, TSK_MIPS, TSK_DEFRAG, TSK_END, TSK_UPBUF, TSK_UPTEX, TSK_CPTEX };
+static const char *const tsk_names[] = { "start", "render", "copy", "blit", "mips", "defrag", "end", "upload-buffer(KB)", "upload-texture", "copy-texture" };
+
+static void VULKAN_INTERNAL_Stamp(VulkanRenderer *renderer, VulkanCommandBuffer *cb, Uint8 kind, Uint32 w, Uint32 h)
+{
+    if (renderer->tsPool == VK_NULL_HANDLE || cb->tsSlot < 0 || cb->tsCount >= TS_PER_CB) {
+        return;
+    }
+    renderer->vkCmdWriteTimestamp(cb->commandBuffer, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, renderer->tsPool,
+                                  (Uint32)cb->tsSlot * TS_PER_CB + cb->tsCount);
+    cb->tsKind[cb->tsCount] = kind;
+    cb->tsW[cb->tsCount] = (Uint16)(w > 65535 ? 65535 : w);
+    cb->tsH[cb->tsCount] = (Uint16)(h > 65535 ? 65535 : h);
+    cb->tsCount += 1;
+}
+
+static void VULKAN_INTERNAL_StampCollect(VulkanRenderer *renderer, VulkanCommandBuffer *cb)
+{
+    Uint64 t[TS_PER_CB];
+    Uint32 i, k;
+    if (renderer->tsPool == VK_NULL_HANDLE || cb->tsSlot < 0 || cb->tsCount < 2) {
+        cb->tsCount = 0;
+        return;
+    }
+    if (renderer->vkGetQueryPoolResults(renderer->logicalDevice, renderer->tsPool, (Uint32)cb->tsSlot * TS_PER_CB,
+                                        cb->tsCount, sizeof(t), t, sizeof(Uint64), VK_QUERY_RESULT_64_BIT) == VK_SUCCESS) {
+        double cbms = (double)(t[cb->tsCount - 1] - t[0]) * renderer->tsPeriodNs / 1e6;
+        renderer->tsTotalMs += cbms;
+        renderer->tsAccumMs += cbms;
+        if (cb->presentDataCount > 0) {
+            renderer->tsFrameMs = renderer->tsAccumMs;
+            renderer->tsFrameAvg = renderer->tsFrames++ ? renderer->tsFrameAvg * 0.9 + renderer->tsAccumMs * 0.1 : renderer->tsAccumMs;
+            renderer->tsAccumMs = 0;
+        }
+        for (i = 0; i + 1 < cb->tsCount; i += 1) {
+            double ms = (double)(t[i + 1] - t[i]) * renderer->tsPeriodNs / 1e6;
+            for (k = 0; k < renderer->tsAggN; k += 1) {
+                if (renderer->tsAgg[k].kind == cb->tsKind[i] && renderer->tsAgg[k].w == cb->tsW[i] && renderer->tsAgg[k].h == cb->tsH[i]) {
+                    break;
+                }
+            }
+            if (k == renderer->tsAggN) {
+                if (k == SDL_arraysize(renderer->tsAgg)) {
+                    k -= 1; /* full: lump into the last entry */
+                } else {
+                    renderer->tsAggN += 1;
+                    renderer->tsAgg[k].kind = cb->tsKind[i];
+                    renderer->tsAgg[k].w = cb->tsW[i];
+                    renderer->tsAgg[k].h = cb->tsH[i];
+                    renderer->tsAgg[k].ms = 0;
+                    renderer->tsAgg[k].n = 0;
+                }
+            }
+            renderer->tsAgg[k].ms += ms;
+            renderer->tsAgg[k].n += 1;
+        }
+        if (++renderer->tsCbs == 300 && !renderer->tsLog) {
+            renderer->tsCbs = 0;
+            renderer->tsAggN = 0;
+            renderer->tsTotalMs = 0;
+        } else if (renderer->tsCbs == 300) {
+            char line[2048];
+            size_t len = 0;
+            Uint32 j, best;
+            bool used[48];
+            SDL_zeroa(used);
+            len += SDL_snprintf(line + len, sizeof(line) - len, "GPU pass timing: %.2f ms per command buffer;", renderer->tsTotalMs / 300.0);
+            for (j = 0; j < 10 && j < renderer->tsAggN; j += 1) {
+                best = 0xFFFFFFFF;
+                for (k = 0; k < renderer->tsAggN; k += 1) {
+                    if (!used[k] && (best == 0xFFFFFFFF || renderer->tsAgg[k].ms > renderer->tsAgg[best].ms)) {
+                        best = k;
+                    }
+                }
+                used[best] = true;
+                len += SDL_snprintf(line + len, sizeof(line) - len, " %s %ux%u %.2f ms (%.1f/cb)", tsk_names[renderer->tsAgg[best].kind],
+                                    renderer->tsAgg[best].w, renderer->tsAgg[best].h, renderer->tsAgg[best].ms / 300.0,
+                                    renderer->tsAgg[best].n / 300.0);
+                if (len >= sizeof(line) - 64) {
+                    break;
+                }
+            }
+            SDL_LogInfo(SDL_LOG_CATEGORY_GPU, "%s", line);
+            renderer->tsCbs = 0;
+            renderer->tsAggN = 0;
+            renderer->tsTotalMs = 0;
+        }
+    }
+    cb->tsCount = 0;
+}
