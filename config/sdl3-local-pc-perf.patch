+/* 2K5Remade local: the pipeline cache on disk. NVIDIA's own shader cache
+ * is size-limited and shared by every game, and drivers without one compile
+ * every pipeline from scratch each run (~0.1-0.8 s each). The file holds the
+ * driver's VkPipelineCache blob; the driver checks its header (vendor,
+ * device, driver UUID) and ignores data from another driver. */
+static bool VULKAN_INTERNAL_SavePipelineCache(VulkanRenderer *renderer, const char *path)
+{
+    size_t size = 0;
+    void *data;
+    char tmp[1024];
+    SDL_IOStream *io;
+    bool ok = false;
+    if (renderer->pipelineCache == VK_NULL_HANDLE || !path || !*path) {
+        return false;
+    }
+    if (renderer->vkGetPipelineCacheData(renderer->logicalDevice, renderer->pipelineCache, &size, NULL) != VK_SUCCESS || size == 0) {
+        return false;
+    }
+    data = SDL_malloc(size);
+    if (!data) {
+        return false;
+    }
+    if (renderer->vkGetPipelineCacheData(renderer->logicalDevice, renderer->pipelineCache, &size, data) == VK_SUCCESS) {
+        SDL_snprintf(tmp, sizeof(tmp), "%s.tmp", path);
+        io = SDL_IOFromFile(tmp, "wb");
+        if (io) {
+            ok = SDL_WriteIO(io, data, size) == size;
+            ok = SDL_CloseIO(io) && ok;
+            if (ok) {
+                ok = SDL_RenamePath(tmp, path);
+            }
+            if (!ok) {
+                SDL_RemovePath(tmp);
+            }
+        }
+    }
+    SDL_free(data);
+    return ok;
+}
+
+static void VULKAN_INTERNAL_LoadPipelineCache(VulkanRenderer *renderer)
+{
+    const char *path = SDL_getenv("SDL_GPU_VULKAN_PIPELINE_CACHE");
+    VkPipelineCacheCreateInfo ci;
+    size_t size = 0;
+    void *data = NULL;
+    SDL_zero(ci);
+    ci.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO;
+    if (path && *path) {
+        data = SDL_LoadFile(path, &size);
+    }
+    ci.initialDataSize = data ? size : 0;
+    ci.pInitialData = data;
+    if (renderer->vkCreatePipelineCache(renderer->logicalDevice, &ci, NULL, &renderer->pipelineCache) != VK_SUCCESS) {
+        /* rejected data: start empty */
+        ci.initialDataSize = 0;
+        ci.pInitialData = NULL;
+        if (renderer->vkCreatePipelineCache(renderer->logicalDevice, &ci, NULL, &renderer->pipelineCache) != VK_SUCCESS) {
+            renderer->pipelineCache = VK_NULL_HANDLE;
+        }
+    }
+    if (path && *path) {
+        SDL_LogInfo(SDL_LOG_CATEGORY_GPU, "Vulkan pipeline cache: %u KB loaded from %s", (unsigned)(data ? size >> 10 : 0), path);
+    }
+    SDL_free(data);
+}
+
+/* Writes the device's pipeline cache to `path` (temporary file, then
+ * rename). Returns false on other drivers or when nothing could be written. */
+/* 2K5Remade local: GPU time of the last presented frame and its running
+ * average, from the pass timestamps (SDL_GPU_FRAME_TIMING=1 or
+ * SDL_GPU_PASS_TIMING=1 at device creation). False when unavailable. */
+SDL_DECLSPEC bool SDLCALL SDL_GetGPUFrameTimeVulkan(SDL_GPUDevice *device, double *last_ms, double *avg_ms)
+{
+    VulkanRenderer *renderer;
+    if (!device || SDL_strcmp(SDL_GetGPUDeviceDriver(device), "vulkan") != 0) {
+        return false;
+    }
+    renderer = (VulkanRenderer *)device->driverData;
+    if (renderer->tsPool == VK_NULL_HANDLE || renderer->tsFrames == 0) {
+        return false;
+    }
+    if (last_ms) *last_ms = renderer->tsFrameMs;
+    if (avg_ms) *avg_ms = renderer->tsFrameAvg;
+    return true;
+}
+
+SDL_DECLSPEC bool SDLCALL SDL_SaveGPUPipelineCacheVulkan(SDL_GPUDevice *device, const char *path)
+{
+    if (!device || SDL_strcmp(SDL_GetGPUDeviceDriver(device), "vulkan") != 0) {
+        return false;
+    }
+    return VULKAN_INTERNAL_SavePipelineCache((VulkanRenderer *)device->driverData, path);
+}
