+    if (!is_alpha && (flags & 2)) {
+        float d = A[0] * B[0] + A[1] * B[1] + A[2] * B[2];
+        ab[0] = ab[1] = ab[2] = d;
+    } else {
+        for (i = 0; i < n; i++) ab[i] = A[i] * B[i];
+    }
