+ * vertex, even per pixel. CRT getenv takes the environment lock the title's
+ * own threads also contend for, which slowed the whole game down enough to
+ * change menu timing. The environment does not change while running, so
+ * every lookup is cached after its first read. */
+static const char *env_cached(const char *name)
+{
+    /* Pointer compares first (call sites pass literals), strcmp only as a
+     * fallback; 32 slots overflowed once the debug switches multiplied, and
+     * every name past them went to getenv on every call. */
+    static struct { const char *name; const char *value; } cache[256];
+    static volatile LONG count;
+    LONG i, n = count;
+    const char *v;
+    for (i = 0; i < n; i++)
+        if (cache[i].name == name)
+            return cache[i].value;
+    for (i = 0; i < n; i++)
+        if (strcmp(cache[i].name, name) == 0)
+            return cache[i].value;
+    v = getenv(name);
+    if (n < 256) {
+        cache[n].name = name;
+        cache[n].value = v;
