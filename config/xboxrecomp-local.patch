+        uint32_t service_context = 0x800008C4u;
+        uint32_t device = BRIDGE_MEM32(service_context);
+        if (diag_count < 10) {
+            uint32_t status = device ? BRIDGE_MEM32(device + 0xCu) : 0;
+            uint32_t enable = device ? BRIDGE_MEM32(device + 0x10u) : 0;
+            uint32_t counter = BRIDGE_MEM32(service_context + 0x418u);
+            diag_count++;
+            fprintf(stderr, "  [VBLANK-DIAG] #%d device=0x%08X status=0x%08X "
+                    "enable=0x%08X gate=0x%08X counter@+0x418=0x%08X\n",
+                    diag_count, device, status, enable, status & enable, counter);
+        }
+        if (device) {
+            /* enable needs BOTH the master bit (0x80000000, checked
