+static void bridge_dispatch_scheduler_after_queue_unlock(void)
+{
+    LONG suppressed = g_scheduler_tick_suppressed;
+    /* The specific queue lock has already been released by ordinal 294, so
+     * the worker-wait suppression no longer applies at this boundary. */
+    g_scheduler_tick_suppressed = 0;
+    bridge_dispatch_scheduler_tick();
+    g_scheduler_tick_suppressed = suppressed;
+}
