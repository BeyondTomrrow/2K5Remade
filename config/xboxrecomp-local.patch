+        ID3D11Device_CreateBuffer(s_gpu11.dev, &bd, NULL, &s_vp_ib);
+        bd.ByteWidth = (sizeof(GpuVpConsts) + 15) & ~15u; bd.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+        ID3D11Device_CreateBuffer(s_gpu11.dev, &bd, NULL, &s_vp_cb);
+    }
