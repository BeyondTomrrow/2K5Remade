+                g_esp -= 4; BRIDGE_MEM32(g_esp) = item.system_arg1;
+                g_esp -= 4; BRIDGE_MEM32(g_esp) = context;
+                g_esp -= 4; BRIDGE_MEM32(g_esp) = item.dpc_va;
+                g_esp -= 4; BRIDGE_MEM32(g_esp) = 0;
