+static bridge_guest_timer *bridge_arm_guest_timer(uint32_t timer_va,
+    uint32_t dpc_va, uint64_t due_100ns, LONG period_ms)
+{
+    bridge_guest_timer *slot = NULL;
+    DWORD due_ms;
+    InitOnceExecuteOnce(&g_pending_dpc_once, bridge_init_dpc_lock, NULL, NULL);
+    EnterCriticalSection(&g_pending_dpc_lock);
+    for (unsigned i = 0; i < BRIDGE_GUEST_TIMERS; ++i) {
+        if (g_guest_timers[i].timer_va == timer_va || !g_guest_timers[i].timer_va) {
+            slot = &g_guest_timers[i]; break;
+        }
+    }
+    if (slot && slot->host_timer) DeleteTimerQueueTimer(NULL, slot->host_timer, NULL);
+    if (slot) {
+        slot->timer_va = timer_va; slot->dpc_va = dpc_va; slot->period_ms = period_ms;
+        due_ms = (due_100ns && due_100ns / 10000u) ? (DWORD)(due_100ns / 10000u) : 1u;
+        if (!CreateTimerQueueTimer(&slot->host_timer, NULL, bridge_guest_timer_expired,
+            slot, due_ms, period_ms > 0 ? (DWORD)period_ms : 0,
+            period_ms > 0 ? 0 : WT_EXECUTEONLYONCE)) slot = NULL;
+    }
+    LeaveCriticalSection(&g_pending_dpc_lock);
