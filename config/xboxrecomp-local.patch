+     * guest thread. Anything queued meanwhile runs on the next pass. */
+    LONG stop_at;
+    InitOnceExecuteOnce(&g_pending_dpc_once, bridge_init_dpc_lock, NULL, NULL);
+    EnterCriticalSection(&g_pending_dpc_lock);
+    stop_at = g_pending_dpc_tail;
+    LeaveCriticalSection(&g_pending_dpc_lock);
+    for (;;) {
+        bridge_guest_dpc item;
+        InitOnceExecuteOnce(&g_pending_dpc_once, bridge_init_dpc_lock, NULL, NULL);
+        EnterCriticalSection(&g_pending_dpc_lock);
+        if (g_pending_dpc_head == g_pending_dpc_tail || g_pending_dpc_head == stop_at) {
+            LeaveCriticalSection(&g_pending_dpc_lock);
+            break;
+        }
+        item = g_pending_dpcs[g_pending_dpc_head];
+        g_pending_dpc_head = (g_pending_dpc_head + 1) % BRIDGE_PENDING_DPCS;
+        LeaveCriticalSection(&g_pending_dpc_lock);
+        InterlockedIncrement(&nfl2k5_dpc_drained_count);
