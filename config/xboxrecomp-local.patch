+        case 0x60: x = -2.0f * p + 1.0f; break;                         /* expand negate     */
+        case 0x80: x = p - 0.5f; break;                                 /* half-bias normal  */
+        case 0xA0: x = -p + 0.5f; break;                                /* half-bias negate  */
