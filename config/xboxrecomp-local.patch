+
+static int gpu_vp_bind(uint32_t nverts, uint32_t nidx, uint32_t rw, uint32_t rh, ID3D11VertexShader *vs)
+{
+    D3D11_MAPPED_SUBRESOURCE m;
+    GpuVpConsts k;
