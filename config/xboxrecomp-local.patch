+    BRIDGE_MEM32(timer->timer_va + 4) = 1; /* DISPATCHER_HEADER.SignalState */
+    bridge_queue_guest_dpc(timer->timer_va, timer->dpc_va, 0, 0);
+    if (timer->period_ms == 0) timer->host_timer = NULL;
