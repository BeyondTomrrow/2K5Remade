+    case 0x08: x -= 0.5f; break;
+    case 0x10: x *= 2.0f; break;
+    case 0x18: x = (x - 0.5f) * 2.0f; break;
+    case 0x20: x *= 4.0f; break;
+    case 0x30: x *= 0.5f; break;
