+static void bridge_queue_guest_dpc(uint32_t timer_va, uint32_t dpc_va,
+    uint32_t system_arg1, uint32_t system_arg2)
+{
+    InitOnceExecuteOnce(&g_pending_dpc_once, bridge_init_dpc_lock, NULL, NULL);
+    EnterCriticalSection(&g_pending_dpc_lock);
+    LONG next = (g_pending_dpc_tail + 1) % BRIDGE_PENDING_DPCS;
+    if (next != g_pending_dpc_head) {
+        g_pending_dpcs[g_pending_dpc_tail].timer_va = timer_va;
+        g_pending_dpcs[g_pending_dpc_tail].dpc_va = dpc_va;
+        g_pending_dpcs[g_pending_dpc_tail].system_arg1 = system_arg1;
+        g_pending_dpcs[g_pending_dpc_tail].system_arg2 = system_arg2;
+        g_pending_dpc_tail = next;
+        InterlockedIncrement(&nfl2k5_dpc_queued_count);
+    }
+    LeaveCriticalSection(&g_pending_dpc_lock);
