+static int gpu_vp_ring_write(ID3D11Buffer *buf, UINT cap, UINT *pos, const void *src, UINT size, UINT *at)
+{
+    D3D11_MAPPED_SUBRESOURCE m;
+    D3D11_MAP how = D3D11_MAP_WRITE_NO_OVERWRITE;
+    if (size > cap)
