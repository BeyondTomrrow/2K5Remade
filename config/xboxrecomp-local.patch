+        return 0;
+    if (!gpu_vp_ring_write(s_vp_vb, GPU_VP_RING_VB, &s_vp_vb_pos, s_vp_in,
+                           (UINT)(nverts * sizeof s_vp_in[0]), &vb_at))
+        return 0;
+    if (!gpu_vp_ring_write(s_vp_ib, GPU_VP_RING_IB, &s_vp_ib_pos, s_vp_ix, (UINT)(nidx * 4), &ib_at))
+        return 0;
