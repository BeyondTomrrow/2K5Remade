+/* Admit scheduler entries from guest context.  The timer queue thread only
+ * marks an injected service pass pending; it never enters translated code.
+ * The retail title also calls this dispatcher directly while stack-backed
+ * frontend requests are live.  Those title-owned calls must run immediately:
+ * waiting for a host VBlank there lets the producer return and invalidates the
+ * queued request before its callback consumes it. */
+int xbox_bridge_begin_title_tick(DWORD timeout_ms)
+{
+    DWORD wait_result;
+
+    /* bridge_dispatch_scheduler_tick grants exactly one entry to the outer
+     * translated dispatcher.  Direct recursive dispatcher calls made by its
+     * callbacks receive no permit and are rejected below. */
+    if (InterlockedExchange(&g_scheduler_tick_permit, 0) != 0) {
+        if (InterlockedCompareExchange(&g_title_scheduler_active, 1, 0) == 0) {
+            g_title_scheduler_depth = 1;
+            return 1;
+        }
+        return 0;
+    }
+
+    /* A scheduler callback can synchronously enqueue dependent work then
+     * invoke sub_00038CD0 again before its stack-backed descriptor expires.
+     * The guest callback table already marks the running slot active, so an
+     * inner pass skips that slot and can advance the dependent ones safely. */
+    if (g_scheduler_tick_active || g_title_scheduler_depth > 0) {
+        ++g_title_scheduler_depth;
+        return 1;
+    }
+    if (InterlockedCompareExchange(&g_title_scheduler_active, 1, 0) != 0)
+        return 0;
+    g_title_scheduler_depth = 1;
+
+    /* This is a real title call rather than bridge_dispatch_scheduler_tick().
+     * Its caller defines the cadence and, for async frontend setup, owns the
+     * lifetime of the request descriptor.  Do not wait on the host timer. */
+    (void)timeout_ms;
+    (void)wait_result;
+    return 1;
+}
+
+void xbox_bridge_end_title_tick(void)
+{
+    if (g_title_scheduler_depth > 0 && --g_title_scheduler_depth == 0)
+        InterlockedExchange(&g_title_scheduler_active, 0);
+}
+
+/* The retail title expects its registered scheduler callbacks to be advanced
+ * by a periodic kernel/video tick.  The host has no NV2A interrupt source, so
+ * emit that pulse only at a bridge boundary already executing on the guest
+ * thread.  This avoids corrupting TLS registers or the guest stack from a
+ * Windows timer callback. */
+static void bridge_dispatch_scheduler_tick(void)
+{
+    recomp_func_t scheduler;
+    uint32_t save_eax, save_ecx, save_edx, save_esp;
+    uint32_t save_ebx, save_esi, save_edi, save_ebp, save_seh_ebp;
+
+    /* Do not consume the initial 16 ms slot before the title has populated
+     * B04D20/B04D24.  Early boot drains DPCs too, but there is no work for
+     * the dispatcher until its five base callbacks are registered. */
+    if (BRIDGE_MEM32(0x00B04D1Cu) < 5u)
+        return;
+    /* A Windows timer only marks a pulse pending.  The pulse belongs to the
+     * title thread that populated the scheduler table; servicing it from a
+     * real worker thread can re-enter game state with the wrong guest TLS. */
+    if (g_scheduler_guest_thread != 0 &&
+        g_scheduler_guest_thread != (LONG)GetCurrentThreadId())
+        return;
+    if (g_scheduler_tick_suppressed)
+        return;
+    if (InterlockedExchange(&g_scheduler_tick_pending, 0) == 0)
+        return;
+    if (InterlockedCompareExchange(&g_scheduler_tick_active, 1, 0) != 0) {
+        InterlockedExchange(&g_scheduler_tick_pending, 1);
+        return;
+    }
+    scheduler = recomp_lookup(0x00038CD0u);
+    if (!scheduler) {
+        InterlockedExchange(&g_scheduler_tick_active, 0);
+        return;
+    }
+
+    /* Model an interrupt: scheduler callbacks may change caller-saved guest
+     * registers, but the interrupted title instruction stream must resume
+     * with exactly the context it had at this bridge boundary. */
+    save_eax = g_eax; save_ecx = g_ecx; save_edx = g_edx;
+    save_esp = g_esp; save_ebx = g_ebx; save_esi = g_esi;
+    save_edi = g_edi; save_ebp = g_ebp; save_seh_ebp = g_seh_ebp;
+    g_esp -= 4;
+    BRIDGE_MEM32(g_esp) = 0;
+    InterlockedExchange(&g_scheduler_tick_permit, 1);
+    scheduler();
+    InterlockedExchange(&g_scheduler_tick_permit, 0);
+    g_eax = save_eax; g_ecx = save_ecx; g_edx = save_edx;
+    g_esp = save_esp; g_ebx = save_ebx; g_esi = save_esi;
+    g_edi = save_edi; g_ebp = save_ebp; g_seh_ebp = save_seh_ebp;
+    InterlockedIncrement(&nfl2k5_scheduler_dispatch_count);
+    InterlockedExchange(&g_scheduler_last_dispatch_ms, (LONG)GetTickCount());
+    InterlockedExchange(&g_scheduler_tick_active, 0);
+}
