// Application icon and version information: Explorer, the taskbar and Task
// Manager show "ESPN NFL 2K5" with the game's logo.
#include <winver.h>

1 ICON "nfl2k5.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "ESPN NFL 2K5"
      VALUE "ProductName", "ESPN NFL 2K5"
      VALUE "InternalName", "NFL2K5"
      VALUE "OriginalFilename", "NFL2K5.exe"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
