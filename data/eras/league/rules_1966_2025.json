    {"rule": "kickoff_spot_yardline", "from": 1974, "to": 1993, "value": 35, "notes": "Moved 40 -> 35 in the 1974 reform package.", "source": "https://web.archive.org/web/20220103123107/https://operations.nfl.com/the-rules/evolution-of-the-nfl-rules/"},
    {"rule": "kickoff_spot_yardline", "from": 1994, "to": 2010, "value": 30, "notes": "Return rate had dropped to 68%; rose to 88% in 1994.", "source": "https://web.archive.org/web/20220103123107/https://operations.nfl.com/the-rules/evolution-of-the-nfl-rules/"},
    {"rule": "kickoff_spot_yardline", "from": 2011, "to": 2025, "value": 35, "notes": "Back to the 35; coverage team may not line up more than 5 yards behind the ball (2011), 1 yard (2018).", "source": "https://en.wikipedia.org/wiki/2011_NFL_season#Rule_changes"},
    {"rule": "kickoff_format", "from": 1966, "to": 2023, "value": "traditional", "notes": "Coverage team runs from behind the kicking line. 2009: wedge max 2 players; 2018: set-up zone and no blocking in restraining zone.", "source": "https://en.wikipedia.org/wiki/2018_NFL_season#Rule_changes"},
    {"rule": "kickoff_format", "from": 2024, "to": 2025, "value": "dynamic", "notes": "Kick from the 35; coverage team lines up at the receiving team's 40; landing zone between the receiving 20 and the goal line; short of the landing zone = ball at the receiving 40; no fair catch; Q4 trailing team may declare a traditional onside kick. Trial in 2024, permanent in 2025.", "source": "https://en.wikipedia.org/wiki/2024_NFL_season#Rule_changes"},
    {"rule": "kickoff_out_of_bounds", "from": 1966, "to": 1983, "value": "rekick_5yd", "confidence": "medium", "notes": "Pre-1984 rule inferred from the 1984 change text.", "source": "https://en.wikipedia.org/wiki/1984_NFL_season#Rule_changes"},
    {"rule": "kickoff_out_of_bounds", "from": 1984, "to": 1986, "value": "rekick_5yd_or_spot_after_second", "notes": "5 yards and re-kick; after a second OOB kick the receiving team may take the out-of-bounds spot.", "source": "https://en.wikipedia.org/wiki/1984_NFL_season#Rule_changes"},
    {"rule": "kickoff_out_of_bounds", "from": 1987, "to": 2023, "value": "30yd_from_kick_or_oob_spot", "notes": "Receiving team takes the ball 30 yards from the spot of the kick (the receiving 35 for a kick from the 35, the receiving 40 for a kick from the 30) or at the OOB spot. The 1987 wording excepts the first onside attempt.", "source": "https://en.wikipedia.org/wiki/1987_NFL_season#Rule_changes"},
    {"rule": "kickoff_out_of_bounds", "from": 2024, "to": 2025, "value": "receiving_40", "notes": "Dynamic kickoff: OOB or short of the landing zone = receiving team's 40.", "source": "https://en.wikipedia.org/wiki/2024_NFL_season#Rule_changes"},

