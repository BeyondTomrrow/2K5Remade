      "duration": 4.0,
      "layers": [
        { "type": "box", "x": 86, "y": 7, "w": 222, "h": 42, "radius": 7,
          "gradient": { "top": "{team.primary}|lighten:0.1", "bottom": "{team.primary}|darken:0.3" },
          "enter": { "type": "wipe_x", "time": 0.3 }, "exit": { "type": "fade", "time": 0.3 } },
        { "type": "text", "text": "SAFETY", "x": 86, "y": 7, "w": 222, "h": 42,
          "size": 30, "weight": 800, "stretch": "condensed", "color": "#FFFFFF", "align": "center",
          "enter": { "type": "wipe_x", "time": 0.3 }, "exit": { "type": "fade", "time": 0.3 } },
        { "type": "box", "at": "team.score_box", "radius": 5, "fill": "#F5C518", "blink": { "period": 0.45, "until": 2.7 } },
        { "type": "text", "at": "team.score_box", "text": "{team.score}",
          "size": 33, "weight": 700, "stretch": "condensed", "color": "#111317", "align": "center",
          "blink": { "period": 0.45, "until": 2.7 } }
      ]
    },

    "timeout": {
      "duration": 3.5,
      "layers": [
        { "type": "box", "x": 86, "y": 7, "w": 222, "h": 42, "radius": 7,
          "gradient": { "top": "{team.primary}|lighten:0.1", "bottom": "{team.primary}|darken:0.3" },
          "enter": { "type": "wipe_x", "time": 0.3 }, "exit": { "type": "fade", "time": 0.3 } },
        { "type": "text", "text": "TIMEOUT {team.abbr}", "x": 86, "y": 7, "w": 222, "h": 42,
          "size": 28, "weight": 800, "stretch": "condensed", "color": "#FFFFFF", "align": "center",
          "enter": { "type": "wipe_x", "time": 0.3 }, "exit": { "type": "fade", "time": 0.3 } },
        { "type": "box", "at": "team.timeouts", "radius": 2, "fill": "#FFFFFF", "blink": { "period": 0.35, "until": 2.8 } }
      ]
    },

    "first_down": {
      "duration": 2.2,
      "layers": [
        { "type": "box", "x": 86, "y": 7, "w": 222, "h": 42, "radius": 7,
          "gradient": { "top": "#FFD84A", "bottom": "#E5AE00" },
          "enter": { "type": "wipe_x", "time": 0.25 }, "exit": { "type": "fade", "time": 0.25 } },
        { "type": "text", "text": "FIRST DOWN", "x": 86, "y": 7, "w": 222, "h": 42,
          "size": 29, "weight": 800, "stretch": "condensed", "color": "#15171B", "align": "center",
          "enter": { "type": "wipe_x", "time": 0.25 }, "exit": { "type": "fade", "time": 0.25 } }
      ]
    },

    "two_minute_warning": {
      "duration": 4.0,
      "layers": [
        { "type": "box", "x": 86, "y": 7, "w": 222, "h": 42, "radius": 7,
          "gradient": { "top": "#E0243A", "bottom": "#8E0E1C" },
          "enter": { "type": "wipe_x", "time": 0.3 }, "exit": { "type": "fade", "time": 0.3 } },
        { "type": "text", "text": "2:00 WARNING", "x": 86, "y": 7, "w": 222, "h": 42,
