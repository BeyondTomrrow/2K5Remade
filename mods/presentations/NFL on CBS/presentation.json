  "pregame_video": { "file": "video/NFL Today Open.mp4", "volume": 1.0 },

  "music": {
    "volume": 0.15,
    "fade_out": 2.5,
    "duck_game_audio": 1.0,
    "mute_game_music": true,
    "duck_under_announcers": 0.35,
    "announcer_level": 0.008,
    "intro": [
      { "title": "NFL on CBS Theme (2023)", "file": "music/NFL on CBS Theme 2023.mp3" }
    ],
    "outro": [
      { "title": "NFL on CBS Theme (2023)", "file": "music/NFL on CBS Theme 2023.mp3" }
    ]
