        { "type": "text", "text": "EXTRA POINT GOOD", "x": 86, "y": 7, "w": 222, "h": 42,
          "size": 25, "weight": 800, "stretch": "condensed", "color": "{team.primary}|darken:0.2", "align": "center",
          "enter": { "type": "fade", "time": 0.2 }, "exit": { "type": "fade", "time": 0.25 } },
        { "type": "box", "at": "team.score_box", "radius": 5, "fill": "#F5C518", "blink": { "period": 0.4, "until": 1.6 } },
        { "type": "text", "at": "team.score_box", "text": "{team.score}",
          "size": 33, "weight": 700, "stretch": "condensed", "color": "#111317", "align": "center",
          "blink": { "period": 0.4, "until": 1.6 } }
      ]
    },

    "two_point": {
      "duration": 3.0,
      "layers": [
        { "type": "box", "x": 86, "y": 7, "w": 222, "h": 42, "radius": 7,
          "gradient": { "top": "{team.primary}|lighten:0.1", "bottom": "{team.primary}|darken:0.3" },
          "enter": { "type": "wipe_x", "time": 0.3 }, "exit": { "type": "fade", "time": 0.3 } },
        { "type": "text", "text": "2-PT CONVERSION", "x": 86, "y": 7, "w": 222, "h": 42,
          "size": 25, "weight": 800, "stretch": "condensed", "color": "#FFFFFF", "align": "center",
          "enter": { "type": "wipe_x", "time": 0.3 }, "exit": { "type": "fade", "time": 0.3 } }
      ]
