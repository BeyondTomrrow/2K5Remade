          "enter": { "type": "wipe_x", "time": 0.3 }, "exit": { "type": "fade", "time": 0.3 } },
        { "type": "text", "text": "END OF {ended_quarter}", "x": 86, "y": 7, "w": 222, "h": 42,
          "size": 27, "weight": 800, "stretch": "condensed", "color": "#FFFFFF", "align": "center",
          "enter": { "type": "wipe_x", "time": 0.3 }, "exit": { "type": "fade", "time": 0.3 } }
      ]
    },

    "halftime": {
      "duration": 6.0,
      "layers": [
        { "type": "box", "x": 86, "y": 7, "w": 222, "h": 42, "radius": 7,
          "gradient": { "top": "#434852", "bottom": "#1B1E23" },
          "enter": { "type": "wipe_x", "time": 0.3 }, "exit": { "type": "fade", "time": 0.3 } },
