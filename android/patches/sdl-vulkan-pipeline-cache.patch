+// Pipeline cache on disk. Drivers like Qualcomm's spend most of a second on
+// each new pipeline; with the cache only the first run ever pays for one.
+static void VULKAN_INTERNAL_SavePipelineCache(VulkanRenderer *renderer)
+{
+    size_t size = 0;
+    void *data;
+    char *tmp;
+    if (!renderer->pipelineCache || !renderer->pipelineCachePath) {
+        return;
+    }
+    // Pipelines are created on several threads; one save at a time, and
+    // only when the cache has grown (a cache hit adds nothing).
+    SDL_LockSpinlock(&renderer->pipelineCacheSaveLock);
+    if (renderer->vkGetPipelineCacheData(renderer->logicalDevice, renderer->pipelineCache, &size, NULL) != VK_SUCCESS || size == 0 ||
+        size == renderer->pipelineCacheSavedSize) {
+        SDL_UnlockSpinlock(&renderer->pipelineCacheSaveLock);
+        return;
+    }
+    data = SDL_malloc(size);
+    if (!data) {
+        SDL_UnlockSpinlock(&renderer->pipelineCacheSaveLock);
+        return;
+    }
+    if (renderer->vkGetPipelineCacheData(renderer->logicalDevice, renderer->pipelineCache, &size, data) == VK_SUCCESS &&
+        SDL_asprintf(&tmp, "%s.tmp", renderer->pipelineCachePath) > 0) {
+        if (SDL_SaveFile(tmp, data, size)) {
+            SDL_RemovePath(renderer->pipelineCachePath);
+            SDL_RenamePath(tmp, renderer->pipelineCachePath);
+            renderer->pipelineCacheSavedSize = size;
+        }
+        SDL_free(tmp);
+    }
+    SDL_free(data);
+    SDL_UnlockSpinlock(&renderer->pipelineCacheSaveLock);
+}
+
+static int SDLCALL VULKAN_INTERNAL_PipelineCacheThread(void *data);
+
+static void VULKAN_INTERNAL_CreatePipelineCache(VulkanRenderer *renderer)
+{
+    VkPipelineCacheCreateInfo info;
+    const char *path = SDL_getenv_unsafe("SDL_GPU_VULKAN_PIPELINE_CACHE");   // set by the app with setenv()
+    size_t size = 0;
+    Uint8 *data = NULL;
+    SDL_zero(info);
+    info.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO;
+    if (path && *path) {
+        renderer->pipelineCachePath = SDL_strdup(path);
+        data = (Uint8 *)SDL_LoadFile(path, &size);
+        // Only hand the driver data it wrote itself: header length, version,
+        // vendor, device and cache UUID must all match this device.
+        if (data && size >= 32) {
+            const VkPhysicalDeviceProperties *pp = &renderer->physicalDeviceProperties.properties;
+            Uint32 hdr[4];
+            SDL_memcpy(hdr, data, sizeof(hdr));
+            if (hdr[0] >= 32 && hdr[1] == VK_PIPELINE_CACHE_HEADER_VERSION_ONE &&
+                hdr[2] == pp->vendorID && hdr[3] == pp->deviceID &&
+                SDL_memcmp(data + 16, pp->pipelineCacheUUID, VK_UUID_SIZE) == 0) {
+                info.initialDataSize = size;
+                info.pInitialData = data;
+            }
+        }
+    }
+    if (renderer->vkCreatePipelineCache(renderer->logicalDevice, &info, NULL, &renderer->pipelineCache) != VK_SUCCESS) {
+        renderer->pipelineCache = VK_NULL_HANDLE;
+    }
+    SDL_LogInfo(SDL_LOG_CATEGORY_GPU, "Vulkan pipeline cache: %s (%u bytes loaded)",
+                renderer->pipelineCachePath ? renderer->pipelineCachePath : "memory only",
+                (unsigned)info.initialDataSize);
+    SDL_free(data);
+    if (renderer->pipelineCache && renderer->pipelineCachePath) {
+        renderer->pipelineCacheQuit = SDL_CreateSemaphore(0);
+        if (renderer->pipelineCacheQuit) {
+            renderer->pipelineCacheThread = SDL_CreateThread(VULKAN_INTERNAL_PipelineCacheThread, "vk_pcsave", renderer);
+        }
+    }
+}
+
+// An Android app is usually killed, not shut down, so a save only at device
+// destruction would rarely happen and every unsaved pipeline would compile
+// again next run. Saving at creation put vkGetPipelineCacheData and a rewrite
+// of the whole file (on shared storage) on the thread that draws, for every
+// new pipeline. This thread saves at most every few seconds instead, and only
+// after new pipelines.
+#define VULKAN_PIPELINE_CACHE_SAVE_MS 4000
+static int SDLCALL VULKAN_INTERNAL_PipelineCacheThread(void *data)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)data;
+    SDL_SetCurrentThreadPriority(SDL_THREAD_PRIORITY_LOW);
+    while (!SDL_WaitSemaphoreTimeout(renderer->pipelineCacheQuit, VULKAN_PIPELINE_CACHE_SAVE_MS)) {
+        if (SDL_SetAtomicInt(&renderer->pipelinesSinceCacheSave, 0) != 0) {
+            VULKAN_INTERNAL_SavePipelineCache(renderer);
+        }
+    }
+    return 0;
+}
+
+static void VULKAN_INTERNAL_NotePipelineCreated(VulkanRenderer *renderer)
+{
+    if (renderer->pipelineCachePath) {
+        SDL_AddAtomicInt(&renderer->pipelinesSinceCacheSave, 1);
+        if (!renderer->pipelineCacheThread) {
+            // no saver thread could start: keep the pipelines on disk anyway
+            VULKAN_INTERNAL_SavePipelineCache(renderer);
+        }
+    }
+}
